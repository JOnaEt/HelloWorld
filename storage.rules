rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — owner can write, any authenticated user can read
    match /profiles/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Devotional audio and cover images — admin uploads, all members read
    match /devotionals/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Announcement images — admin uploads, all members read
    match /announcements/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Church branding (logo, etc.) — admin uploads, all members read
    match /church/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
